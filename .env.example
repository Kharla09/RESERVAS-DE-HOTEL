# Configuración de Conexión a Supabase
# Obtén estos datos en tu panel de Supabase: Project Settings -> API
# 1. Project URL (Ejemplo: https://xyzcompany.supabase.co)
SUPABASE_URL=

# 2. Project API Key (anon public key o service_role key)
SUPABASE_KEY=

# Alternativamente puedes usar SUPABASE_ANON_KEY:
SUPABASE_ANON_KEY=
