# Configuración de Conexión a Supabase
# Obtén estos datos en tu panel de Supabase: Project Settings -> API
# 1. Project URL (Ejemplo: https://xyzcompany.supabase.co)
SUPABASE_URL=

# 2. Project API Key (anon public key o service_role key)
# Para el panel de administración en el servidor, usar la service_role key otorga acceso completo
SUPABASE_KEY=

# Alternativamente puedes usar SUPABASE_ANON_KEY:
SUPABASE_ANON_KEY=

# -------------------------------------------------------------
# Credenciales del Perfil de Administrador
# -------------------------------------------------------------
# Usuario o correo para entrar al panel administrativo (/admin.html)
ADMIN_USER=admin

# Contraseña secreta para entrar al panel administrativo
ADMIN_PASSWORD=paraiso2026

